@model Employee
@{
    ViewData["Title"] = "Employee Info";
}
<h1 class="text-center"> @ViewData["Title"]</h1>

<form asp-action="/" method="post">
    <input asp-for="Id" type="hidden" name="Id" id="Id" value="@Model.Id" />
    <label>Employee Name : </label>
    <input asp-for="Name" type="text" name="Name" id="Name" placeholder="Enter Employee Name" disabled/>
    <br />    <br />

    <label>Employee Email : </label>
    <input asp-for="Email" type="email" name="Email" id="Email" placeholder="Enter Employee Email" disabled />
    <br />    <br />

    <label>Employee Phone</label>
    <input asp-for="Phone" type="tel" name="Phone" id="Phone" placeholder="Enter Employee Phone" disabled />
    <br />    <br />

    <label>Employee Address</label>
    <input asp-for="Address" type="text" name="Address" id="Address" placeholder="Enter Employee Address" disabled />
    <br />    <br />

    <label>Employee Salary</label>
    <input asp-for="Salary" type="number" name="Salary" id="Salary" title="Enter Salary Between 3000 and 10000" max="10000" min="3000" disabled />
    <br />    <br />
    <label>Employee Department</label>
    <input asp-for="DepartmentId" type="number" name="DepartmentId" id="DepartmentId" />
    <br />    <br />

    <a asp-action="Update" asp-route-Id="@Model.Id"  class="btn btn-warning">Update</a>
    <a asp-action="Delete" asp-route-Id="@Model.Id" class="btn btn-danger">delete</a>
    <a asp-action="Index"  class="btn btn-secondary">Employees Page</a>

</form>