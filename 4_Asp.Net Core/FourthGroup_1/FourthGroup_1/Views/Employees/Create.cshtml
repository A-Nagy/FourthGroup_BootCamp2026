@model Employee
@{
    ViewData["Title"] = "Add Employee";
}
<h1 class="text-center">Add Employee</h1>

<form action="Create" method="post">

    <label>Employee Name : </label>
    <input asp-for="Name" type="text" name="Name" id="Name" placeholder="Enter Employee Name" />
    <br />    <br />

    <label>Employee Email : </label>
    <input asp-for="Email" type="email" name="Email" id="Email"  placeholder="Enter Employee Email" />
    <br />    <br />

    <label>Employee Phone</label>
    <input asp-for="Phone" type="tel" name="Phone" id="Phone" placeholder="Enter Employee Phone"/>
    <br />    <br />

    <label>Employee Address</label>
    <input asp-for="Address" type="text" name="Address" id="Address" placeholder="Enter Employee Address" />
    <br />    <br />

    <label>Employee Salary</label>
    <input asp-for="Salary" type="number" name="Salary" id="Salary" title="Enter Salary Between 3000 and 10000" max="10000" min="3000" />
    <br />    <br />
    <button type="submit" class="btn btn-success">Save</button>

</form>