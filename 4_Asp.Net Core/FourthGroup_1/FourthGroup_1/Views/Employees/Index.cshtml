@model IEnumerable<Employee>


@{
    ViewData["Title"] = "Employees";
}

<h1 class="text-center">Employees Mangment</h1>

 
<table class="table table-bordered" >
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Address</th>
            <th>Salary</th>
            <th>Phone</th>
            <th>Department</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Name</td>
                <td>@employee.Email</td>
                <td>@employee.Address</td>
                <td>@employee.Salary</td>
                <td>@employee.Phone</td>
                <td>@employee.Department?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-secondary">Details</a>
                    <a asp-action="Update"  asp-route-id="@employee.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete"  asp-route-id="@employee.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    </table>
    <a asp-action="Create" class="btn btn-success">Add Employee</a>
    <a asp-action="Search" class="btn btn-outline-dark">Search</a>