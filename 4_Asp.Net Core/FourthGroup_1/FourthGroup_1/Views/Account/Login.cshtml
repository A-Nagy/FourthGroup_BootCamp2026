@model FourthGroup_1.Models.ViewModels.LoginViewModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<form asp-action="Login" method="post">
    <div class="p-2 mb-2">
        <label asp-for="UserName">User Name:</label>
        <input type="text" name="UserName" id="UserName" asp-for="UserName" />
    </div>
    <div class="p-2 mb-2">
        <label asp-for="Password">Password:</label>
        <input type="password" name="Password" id="Password" asp-for="Password" />
    </div>
    <div class="form-check mb-2">
        <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button type="submit">login</button>
</form>
