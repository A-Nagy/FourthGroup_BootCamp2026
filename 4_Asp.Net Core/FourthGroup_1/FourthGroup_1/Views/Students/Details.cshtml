@model Student
@{
    ViewData["Title"] = "Student info";
}
<h1 class="text-center">@ViewData["Title"]</h1>

<form asp-action="Details" method="post">

    <label>Student ID : </label>
    <input asp-for="id" type="text" name="id" id="id" placeholder="Enter Student id" disabled/>
    <br />    <br />

    <label>Student Name : </label>
    <input asp-for="Name" type="text" name="name" id="name" placeholder="Enter Student Name" disabled />
    <br />    <br />

    <label>Student Age</label>
    <input asp-for="Age" type="number" name="age" id="age" placeholder="Enter Student age" disabled />
    <br />    <br />
    <a asp-action="Update" asp-route-Id="@Model.id" class="btn btn-warning">Update</a>
    <a asp-action="Delete" asp-route-Id="@Model.id" class="btn btn-danger">delete</a>
    <a asp-action="Index" class="btn btn-secondary">Student Page</a>
</form>