@model List<Student>


@{
    ViewData["Title"] = "Student";
}

<h1 class="text-center">Student Mangment</h1>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Age</th>
         
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.id</td>
                <td>@student.Name</td>
                <td>@student.Age</td>
         
           
                <td>
                    <a asp-action="Details" asp-route-id="@student.id" class="btn btn-secondary">Details</a>
                    <a asp-action="Update" asp-route-id="@student.id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@student.id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Create" class="btn btn-success">Add Student</a>
 