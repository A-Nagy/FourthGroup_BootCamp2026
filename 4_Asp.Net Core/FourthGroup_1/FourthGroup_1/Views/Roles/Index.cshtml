@using FourthGroup_1.Security
@model IEnumerable<FourthGroup_1.Models.Role>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>

    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.RoleCreate))
    {
   <a asp-action="Create">Create New</a>
    }
 
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.RoleEdit))
                    {
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                               

                    }
                    @if (User.HasClaim(PermissionsNames.ClaimType,PermissionsNames.RoleDelete))
                    {
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>

                    }
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a> 
                <a class="btn btn-info" asp-action="AssignPermissions" asp-route-id="@item.Id">Assign Permissions</a>
            </td>
        </tr>
}
    </tbody>
</table>
