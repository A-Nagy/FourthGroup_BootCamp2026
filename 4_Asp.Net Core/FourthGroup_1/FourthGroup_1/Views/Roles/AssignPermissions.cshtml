@model Role
@{
    ViewData["Title"] = "Assign Permissions";

    List<Permission> permissions = ViewBag.AllPermissions ;
    List<int> AssignedId         = ViewBag.AssignedPermissions;
}

<h1>Assign Permissions</h1>
<h2>@Model.Name Permissions : </h2>
<form asp-action="AssignPermissions" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    @foreach (var permission in permissions)
    {
        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   name="permissionsIds"
                   value="@permission.Id"
                   checked="@(AssignedId!.Contains(permission.Id))" />
            <label class="form-check-label">@permission.Name</label>
        </div>
    }
    <button type="submit" class="btn btn-primary">Save</button>
</form>

